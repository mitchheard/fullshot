{
  "manifest_version": 3,
  "name": "FullShot",
  "version": "1.0.0",
  "description": "Private full-page capture: tiled Claude-ready PDFs and clipboard-pasteable PNGs. No network access.",
  "permissions": ["activeTab", "debugger", "clipboardWrite", "offscreen", "downloads", "storage"],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FullShot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "commands": {
    "capture-default": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Command+Shift+S" },
      "description": "Capture full page (default format)"
    },
    "capture-image": {
      "suggested_key": { "default": "Alt+Shift+I", "mac": "Command+Shift+I" },
      "description": "Capture full page as image"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
